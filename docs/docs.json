{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenAPI Plugin for Payload CMS",
  "description": "OpenAPI 3.0/3.1/3.2 specs generated from your Payload CMS config, with Scalar or Swagger UI",
  "colors": {
    "primary": "#0e9f6e",
    "light": "#26eca9",
    "dark": "#0a7551"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg"
  },
  "fonts": {
    "family": "Geist"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "windsurf",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode",
      "devin-mcp",
      "download-pdf"
    ],
    "display": "header"
  },
  "navigation": {
    "versions": [
      {
        "version": "v0",
        "default": true,
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Documentation",
                "pages": ["introduction", "quick-start", "changelog"]
              },
              {
                "group": "Configuration",
                "pages": [
                  "configuration/overview",
                  "configuration/metadata",
                  "configuration/openapi-version",
                  "configuration/filters",
                  "configuration/security-marking",
                  "configuration/interactive-auth",
                  "configuration/caching",
                  "configuration/extensions",
                  "configuration/docs-ui"
                ]
              },
              {
                "group": "CLI",
                "pages": ["cli/generate"]
              },
              {
                "group": "Guides",
                "pages": [
                  "guides/custom-endpoints",
                  "guides/field-metadata",
                  "guides/plugin-authors",
                  "guides/static-spec",
                  "guides/programmatic-use",
                  "guides/i18n",
                  "guides/examples"
                ]
              },
              {
                "group": "Reference",
                "pages": ["reference/exports"]
              }
            ]
          }
        ]
      },
      {
        "version": "v1",
        "tag": "Beta",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Documentation",
                "pages": ["v1/introduction", "v1/quick-start", "v1/upgrade-guide", "v1/changelog"]
              },
              {
                "group": "Configuration",
                "pages": [
                  "v1/configuration/overview",
                  "v1/configuration/info",
                  "v1/configuration/openapi-version",
                  "v1/configuration/filters",
                  "v1/configuration/security-marking",
                  "v1/configuration/interactive-auth",
                  "v1/configuration/caching",
                  "v1/configuration/extensions",
                  "v1/configuration/docs-ui",
                  "v1/configuration/telemetry"
                ]
              },
              {
                "group": "CLI",
                "pages": ["v1/cli/generate"]
              },
              {
                "group": "Guides",
                "pages": [
                  "v1/guides/custom-endpoints",
                  "v1/guides/field-metadata",
                  "v1/guides/plugin-authors",
                  "v1/guides/static-spec",
                  "v1/guides/programmatic-use",
                  "v1/guides/i18n",
                  "v1/guides/examples"
                ]
              },
              {
                "group": "Reference",
                "pages": ["v1/reference/endpoints", "v1/reference/exports"]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Releases",
        "href": "https://github.com/maximseshuk/payload-plugin-openapi/releases"
      },
      {
        "label": "Donate",
        "href": "https://ko-fi.com/seshuk"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/maximseshuk/payload-plugin-openapi"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/maximseshuk/payload-plugin-openapi"
    }
  }
}
