{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenAPI Plugin for Payload CMS",
  "description": "OpenAPI 3.0/3.1/3.2 specs generated from your Payload CMS config, with Scalar or Swagger UI",
  "colors": {
    "primary": "#10b981",
    "light": "#34d399",
    "dark": "#059669"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg"
  },
  "fonts": {
    "family": "Geist"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "windsurf",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode",
      "devin-mcp",
      "download-pdf"
    ],
    "display": "header"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Documentation",
            "pages": ["introduction", "quick-start", "changelog"]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/overview",
              "configuration/metadata",
              "configuration/openapi-version",
              "configuration/filters",
              "configuration/security-marking",
              "configuration/interactive-auth",
              "configuration/caching",
              "configuration/extensions",
              "configuration/docs-ui"
            ]
          },
          {
            "group": "CLI",
            "pages": ["cli/generate"]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/custom-endpoints",
              "guides/field-metadata",
              "guides/plugin-authors",
              "guides/static-spec",
              "guides/programmatic-use",
              "guides/i18n",
              "guides/examples"
            ]
          },
          {
            "group": "Reference",
            "pages": ["reference/exports"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Releases",
        "href": "https://github.com/maximseshuk/payload-plugin-openapi/releases"
      },
      {
        "label": "Donate",
        "href": "https://ko-fi.com/seshuk"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/maximseshuk/payload-plugin-openapi"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/maximseshuk/payload-plugin-openapi"
    }
  }
}
