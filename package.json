{
  "name": "@seshuk/payload-plugin-openapi",
  "version": "0.2.2",
  "description": "OpenAPI 3.0/3.1/3.2 spec generator for Payload CMS, with Scalar/Swagger UI.",
  "keywords": [
    "api-docs",
    "cms",
    "openapi",
    "openapi-spec",
    "payload",
    "payload-plugin",
    "payloadcms",
    "plugin",
    "scalar",
    "swagger",
    "typescript"
  ],
  "homepage": "https://github.com/maximseshuk/payload-plugin-openapi#readme",
  "bugs": "https://github.com/maximseshuk/payload-plugin-openapi/issues",
  "license": "MIT",
  "author": "Maxim Seshuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximseshuk/payload-plugin-openapi.git"
  },
  "funding": "https://ko-fi.com/V7V61UCT39",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch",
    "dev": "cross-env PAYLOAD_CONFIG_PATH=./tests/payload.config.ts next dev tests --turbo",
    "dev:safe": "rm -rf .next && cross-env PAYLOAD_CONFIG_PATH=./tests/payload.config.ts next dev tests --turbo --port 3001",
    "dev:generate-importmap": "cd tests && cross-env PAYLOAD_CONFIG_PATH=./payload.config.ts payload generate:importmap",
    "docs:check-links": "pnpm --dir docs check-links",
    "docs:dev": "pnpm --dir docs dev",
    "docs:validate": "pnpm --dir docs validate",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release:patch": "pnpm version patch -m \"chore(release): v%s\"",
    "release:minor": "pnpm version minor -m \"chore(release): v%s\"",
    "release:major": "pnpm version major -m \"chore(release): v%s\""
  },
  "dependencies": {
    "@scalar/openapi-types": "^0.9.1"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "^3.85.1",
    "@payloadcms/next": "^3.85.1",
    "@payloadcms/translations": "^3.85.1",
    "@rslib/core": "^0.22.1",
    "@seriousme/openapi-schema-validator": "^2.9.0",
    "cross-env": "^10.1.0",
    "next": "^16.2.9",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "payload": "^3.85.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "7.0.0-alpha.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@payloadcms/translations": "^3.53.0",
    "payload": "^3.53.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
