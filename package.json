{
  "name": "@seshuk/payload-plugin-openapi",
  "version": "1.0.0-beta.1",
  "description": "Payload plugin that generates OpenAPI 3.0/3.1/3.2 docs, with Scalar or Swagger UI",
  "keywords": [
    "api-documentation",
    "openapi",
    "openapi-spec",
    "payload",
    "payload-cms",
    "payload-plugin",
    "payloadcms",
    "rest-api",
    "scalar",
    "swagger",
    "swagger-ui"
  ],
  "homepage": "https://github.com/maximseshuk/payload-plugin-openapi#readme",
  "bugs": "https://github.com/maximseshuk/payload-plugin-openapi/issues",
  "license": "MIT",
  "author": "Maxim Seshuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximseshuk/payload-plugin-openapi.git"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/seshuk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "cross-env PAYLOAD_CONFIG_PATH=./tests/payload.config.ts DATABASE_URL=file:./tests/payload.db next dev tests",
    "dev:generate-importmap": "cd tests && cross-env PAYLOAD_CONFIG_PATH=./payload.config.ts payload generate:importmap",
    "dev:safe": "rm -rf tests/.next && cross-env PAYLOAD_CONFIG_PATH=./tests/payload.config.ts DATABASE_URL=file:./tests/payload.db next dev tests --port 3001",
    "docs:check-links": "pnpm --dir docs check-links",
    "docs:dev": "pnpm --dir docs dev",
    "docs:validate": "pnpm --dir docs validate",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run -c tests/vitest.config.ts",
    "test:coverage": "vitest run -c tests/vitest.config.ts --coverage",
    "test:int": "vitest run -c tests/vitest.config.ts --project int",
    "test:unit": "vitest run -c tests/vitest.config.ts --project unit",
    "test:watch": "vitest -c tests/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scalar/openapi-types": "^0.9.7"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "4.0.0-canary.38",
    "@payloadcms/next": "4.0.0-canary.38",
    "@payloadcms/translations": "4.0.0-canary.38",
    "@payloadcms/ui": "4.0.0-canary.38",
    "@seriousme/openapi-schema-validator": "^2.9.0",
    "@seshuk/payload-plugin-tooling": "0.2.3",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "next": "16.4.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "payload": "4.0.0-canary.38",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@payloadcms/translations": "4.0.0-canary.38",
    "payload": "4.0.0-canary.38"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
