{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "isolatedDeclarations": true,
    "allowJs": false
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": ["./tests"]
}
